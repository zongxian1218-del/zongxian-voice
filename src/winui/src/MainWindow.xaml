<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml —— 三栏骨架

  布局参考 Oopz / Discord（见 docs/ui-design-guideline-2026-10-04.md §2）：
    左栏 240px（会话列表） | 中间自适应（主区域） | 右栏 224px（成员列表）
    顶栏 48px，左下角 56px 自我区（Discord 的惯例位置）

  配色**全部用 WinUI 语义画刷**，跟随系统明暗主题（§5）。
  本文件里不应该出现任何硬编码的颜色值，除了 Mica 无法覆盖的少数场景。

  W0 阶段只有静态骨架，不放真实数据 —— 目的是先把视觉结构定下来。
-->
<Window
    x:Class="zx.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 第 0 行：远端控制横幅（平时 Collapsed 不占高度） -->
            <RowDefinition Height="Auto" />
            <!-- 第 1 行：主内容 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 远端控制横幅（默认隐藏） =================
             全应用信任等级最高的 UI：被控制时必须常驻顶部、
             用系统的"严重"色、且「停止控制」一次点击立即生效。
             详细要求见 ui-design-guideline §4.1。 -->
        <Border x:Name="ControlBanner"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ControlBannerText"
                               Text="对方正在控制你的电脑"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- 停止控制：最大最显眼，且必须能用键盘触及（§6） -->
                <Button Grid.Column="1"
                        x:Name="StopControlButton"
                        Content="停止控制"
                        FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- ================= 主三栏 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="MemberColumn" Width="224" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左栏：会话列表 ========== -->
            <!-- 用 LayerFillColorDefaultBrush："比背景高一层"的语义，
                 而不是写死一个灰色值。Mica 之上会自动形成层次。 -->
            <Grid Grid.Column="0"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,0">
                    <TextBlock Text="棕仙语音"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 会话列表（静态占位，W2 接真实数据） -->
                <ScrollViewer Grid.Row="1" Padding="8,4">
                    <StackPanel Spacing="2">
                        <!-- 选中态 -->
                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="4" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="和朋友的语音"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- 普通态 -->
                        <Border Padding="10,8" CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="晚上看电影"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,8" CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="远程帮家人看电脑"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 左下角：我自己（Discord 的语音控件惯例位置） -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="32" Height="32"
                              VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="我"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <!-- 在线点：说话/在线状态色 -->
                            <Ellipse Width="11" Height="11"
                                     Fill="{ThemeResource ZxSpeakingBrush}"
                                     Stroke="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                     StrokeThickness="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="我" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="麦克风已关"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Spacing="2">
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="7" ToolTipService.ToolTip="麦克风">
                                <FontIcon Glyph="&#xE720;" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="7" ToolTipService.ToolTip="耳机">
                                <FontIcon Glyph="&#xE7F6;" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="7" ToolTipService.ToolTip="设置">
                                <FontIcon Glyph="&#xE713;" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== 中间：主区域 ========== -->
            <!-- 这一层不设 Background，让 Mica 透出来（Mica 就是给主内容区用的） -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶栏：房间名 + 连接质量 + 共享按钮 -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="15"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="和朋友的语音"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 连接质量（W1 接真实 RTT/丢包） -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Spacing="6" Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7"
                                     Fill="{ThemeResource ZxSpeakingBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="延迟 42 ms · 0% 丢包"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    Spacing="6" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="8" ToolTipService.ToolTip="共享屏幕">
                                <FontIcon Glyph="&#xE7F8;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="8" ToolTipService.ToolTip="共享音频">
                                <FontIcon Glyph="&#xE767;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主区域内容：文字形态（消息列表 + 输入框）
                     通话/共享形态在 W1/W3 接入时切到这里 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="16,12">
                        <StackPanel Spacing="16">
                            <TextBlock Text="今天"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />

                            <!-- 消息：朋友A -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="36" Height="36"
                                      VerticalAlignment="Top">
                                    <Ellipse Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                    <TextBlock Text="A"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="朋友A" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="14:02"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="晚上一起看个片子？"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- 消息：我 + 文件卡片 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="36" Height="36"
                                      VerticalAlignment="Top">
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="我"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="我" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="14:03"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="行，我把屏幕共享一下"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                    <!-- 文件卡片（W2 接真实传输进度） -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,8,0,0"
                                            MaxWidth="380"
                                            HorizontalAlignment="Left">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;"
                                                      FontSize="20"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="设计稿.pdf" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="2.4 MB · 已发送"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 输入框：支持拖拽文件到此处 -->
                    <Border Grid.Row="1" Padding="16,12">
                        <Grid Background="{ThemeResource ControlFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8" Padding="12,0" Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Background="Transparent"
                                    BorderThickness="0" Padding="4"
                                    ToolTipService.ToolTip="发送文件">
                                <FontIcon Glyph="&#xE723;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <TextBox Grid.Column="1"
                                     x:Name="MessageInput"
                                     PlaceholderText="输入消息…"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Button Grid.Column="2" Background="Transparent"
                                    BorderThickness="0" Padding="4"
                                    ToolTipService.ToolTip="发送">
                                <FontIcon Glyph="&#xE724;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== 右栏：成员列表 ========== -->
            <Grid Grid.Column="2"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,0">
                    <TextBlock Text="成员 — 3"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1" Padding="8,0" Spacing="2">
                    <!-- 说话中：头像外圈用 ZxSpeakingBrush 描边（不用频谱条，太吵） -->
                    <Border Padding="8,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                         Stroke="{ThemeResource ZxSpeakingBrush}"
                                         StrokeThickness="2" />
                                <TextBlock Text="A"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="朋友A" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 静音：整体降一档对比度 -->
                    <Border Padding="8,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                         Opacity="0.5" />
                                <TextBlock Text="B"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="朋友B" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <FontIcon Glyph="&#xE74F;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 我自己 + 共享中标记 -->
                    <Border Padding="8,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="我"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="我" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3" Padding="5,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="共享中" FontSize="10"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
