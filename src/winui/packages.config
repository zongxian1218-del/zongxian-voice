<?xml version="1.0" encoding="utf-8"?>
<!--
  packages.config —— 用 NuGet 的传统（非 PackageReference）还原方式。

  为什么 C++ 工程必须走这条路：
    PackageReference 是围绕托管项目设计的，NuGet 要按 TFM 去包里找
    lib/ 目录下的程序集。C++ 工程没有 TFM，即使把 TargetFramework 写成
    native 也会在 framework 解析阶段失败（报错是
    "序列不包含任何元素" / "does not reference native,Version=0.0"，
    完全看不出真正原因）。

    官方 WinUI 3 的 C++ 模板用的就是 packages.config + 在 vcxproj 里
    显式 Import 包内的 props/targets。Microsoft.WindowsAppSDK 包提供
    完整的 build/native/*.targets，正是为这种用法准备的。

  还原命令（build\build-winui.cmd 会自动执行）：
    msbuild <proj> /t:Restore /p:RestorePackagesConfig=true
-->
<packages>
  <package id="Microsoft.WindowsAppSDK" version="1.7.250909003" targetFramework="native" />
</packages>
