<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VideoProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="#FF1B1B1B">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 视频区：**不固定尺寸**，跟随窗口拉伸。实际显示矩形由代码按流宽高比居中算出
             （letterbox），覆盖窗口只盖那一块。助手侧 swapchain 保持视频尺寸、由 DXGI 拉伸到
             窗口客户区，所以这里可以是任意尺寸。 -->
        <Border x:Name="VideoArea" Grid.Row="0" Margin="16,16,16,8"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="#FF0A0A0A" BorderBrush="#FF3A3A3A" BorderThickness="1"
                SizeChanged="VideoArea_SizeChanged">
            <TextBlock x:Name="Placeholder" Text="等待视频…（点下面的「开始接收」）"
                       Foreground="#FF6A6A6A"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="#FF262626" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="StartBtn" Content="开始接收" Click="Start_Click"/>
                <Button x:Name="StopBtn" Content="停止" Click="Stop_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="#FFCFCFCF" Text="未启动"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
